{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "dev.rymenants.tvremote",
  "version": "1.16.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "TV Remote Widget",
    "nl": "Afstandsbediening-widget"
  },
  "description": {
    "en": "A proper remote control layout on your Homey dashboard, with a touchpad",
    "nl": "Een echte afstandsbediening op je Homey-dashboard, met touchpad"
  },
  "category": [
    "tools"
  ],
  "brandColor": "#3b3f52",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Geert Rymenants",
    "email": "geert@rymenants.dev"
  },
  "api": {
    "status": {
      "method": "GET",
      "path": "/status",
      "public": true
    },
    "press": {
      "method": "POST",
      "path": "/press",
      "public": true
    },
    "search": {
      "method": "POST",
      "path": "/search",
      "public": true
    },
    "link": {
      "method": "POST",
      "path": "/link",
      "public": true
    },
    "text": {
      "method": "POST",
      "path": "/text",
      "public": true
    },
    "wake": {
      "method": "POST",
      "path": "/wake",
      "public": true
    }
  },
  "flow": {
    "actions": [
      {
        "title": {
          "en": "Open a link",
          "nl": "Open een link"
        },
        "titleFormatted": {
          "en": "Open [[link]]",
          "nl": "Open [[link]]"
        },
        "hint": {
          "en": "An app link, for instance https://www.youtube.com/results?search_query=jazz",
          "nl": "Een app-link, bijvoorbeeld https://www.youtube.com/results?search_query=jazz"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=tv"
          },
          {
            "name": "link",
            "type": "text",
            "title": {
              "en": "Link",
              "nl": "Link"
            },
            "placeholder": {
              "en": "https://…",
              "nl": "https://…"
            }
          }
        ],
        "id": "open_link"
      },
      {
        "title": {
          "en": "Press a key",
          "nl": "Druk op een toets"
        },
        "titleFormatted": {
          "en": "Press [[key]]",
          "nl": "Druk op [[key]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=tv"
          },
          {
            "name": "key",
            "type": "autocomplete",
            "title": {
              "en": "Key",
              "nl": "Toets"
            }
          }
        ],
        "id": "press_key"
      },
      {
        "title": {
          "en": "Type text",
          "nl": "Typ tekst"
        },
        "titleFormatted": {
          "en": "Type [[text]] into the selected field",
          "nl": "Typ [[text]] in het geselecteerde veld"
        },
        "hint": {
          "en": "Only works while a text field is selected on screen.",
          "nl": "Werkt alleen wanneer er op het scherm een tekstvak geselecteerd staat."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=tv"
          },
          {
            "name": "text",
            "type": "text",
            "title": {
              "en": "Text",
              "nl": "Tekst"
            },
            "placeholder": {
              "en": "jazz piano",
              "nl": "jazz piano"
            }
          }
        ],
        "id": "send_text"
      },
      {
        "title": {
          "en": "Wake the television",
          "nl": "Wek de televisie"
        },
        "hint": {
          "en": "Sends magic packets and keeps offering the power command for up to ninety seconds.",
          "nl": "Stuurt magic packets en blijft tot negentig seconden lang het aan-commando aanbieden."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=tv"
          }
        ],
        "id": "wake"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Android TV",
        "nl": "Android TV"
      },
      "class": "tv",
      "capabilities": [
        "onoff",
        "volume_up",
        "volume_down",
        "volume_mute"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/tv/assets/images/small.png",
        "large": "/drivers/tv/assets/images/large.png"
      },
      "settings": [
        {
          "id": "ip",
          "type": "text",
          "label": {
            "en": "IP address",
            "nl": "IP-adres"
          },
          "value": "",
          "hint": {
            "en": "Where the television lives. Give it a fixed address in your router: the pairing survives a change of address, but nothing can reach it until this is corrected.",
            "nl": "Waar de televisie zit. Geef haar een vast adres in je router: de koppeling overleeft een adreswijziging, maar er raakt niets meer bij tot dit is aangepast."
          }
        }
      ],
      "pair": [
        {
          "id": "configure",
          "navigation": {
            "next": "code"
          }
        },
        {
          "id": "code",
          "navigation": {
            "prev": "configure"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "configure",
          "navigation": {
            "next": "code"
          }
        },
        {
          "id": "code"
        }
      ],
      "id": "tv"
    }
  ],
  "widgets": {
    "remote": {
      "name": {
        "en": "TV remote",
        "nl": "Afstandsbediening"
      },
      "height": 500,
      "settings": [],
      "api": {
        "press": {
          "method": "POST",
          "path": "/press"
        },
        "status": {
          "method": "GET",
          "path": "/status"
        },
        "search": {
          "method": "POST",
          "path": "/search"
        },
        "text": {
          "method": "POST",
          "path": "/text"
        }
      },
      "id": "remote"
    }
  }
}