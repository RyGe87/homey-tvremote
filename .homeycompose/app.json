{
  "id": "dev.rymenants.tvremote",
  "version": "1.15.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "TV Remote Widget",
    "nl": "Afstandsbediening-widget"
  },
  "description": {
    "en": "A proper remote control layout on your Homey dashboard, with a touchpad",
    "nl": "Een echte afstandsbediening op je Homey-dashboard, met touchpad"
  },
  "category": [
    "tools"
  ],
  "brandColor": "#3b3f52",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Geert Rymenants",
    "email": "geert@rymenants.dev"
  },
  "api": {
    "status": {
      "method": "GET",
      "path": "/status",
      "public": true
    },
    "press": {
      "method": "POST",
      "path": "/press",
      "public": true
    },
    "search": {
      "method": "POST",
      "path": "/search",
      "public": true
    },
    "text": {
      "method": "POST",
      "path": "/text",
      "public": true
    },
    "wake": {
      "method": "POST",
      "path": "/wake",
      "public": true
    }
  }
}